# ============================================================
#  open-discord-bot – Configuration
#  Copy this file to ".env" and fill in your values.
#  Never commit or share your .env file!
# ============================================================

# ------------------------------------------------------------
#  DISCORD_TOKEN  (required)
#  The token of your bot. Keep it secret!
#  Where to find it:
#    https://discord.com/developers/applications
#    -> your application -> "Bot" -> "Reset Token"
# ------------------------------------------------------------
DISCORD_TOKEN=

# ------------------------------------------------------------
#  LOG_LEVEL  (optional, default: log)
#  How much the bot writes to the console.
#  Allowed values, from least to most output:
#    fatal | error | warn | log | debug | verbose
#  Remove the "#" to change it.
# ------------------------------------------------------------
# LOG_LEVEL=log

# ------------------------------------------------------------
#  DEV_GUILD_ID  (optional, for development only)
#  If set, slash commands are registered ONLY on this server,
#  but they show up instantly. Useful while developing.
#  Leave it unset in production so commands work on all servers.
#
#  How to get the ID:
#    Discord -> User Settings -> Advanced -> enable "Developer Mode",
#    then right-click your server -> "Copy Server ID"
# ------------------------------------------------------------
# DEV_GUILD_ID=

# ============================================================
#  Database
# ============================================================

# ------------------------------------------------------------
#  POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB  (required)
#  Credentials for the PostgreSQL container in compose.yaml.
#  Choose your own secure password!
# ------------------------------------------------------------
POSTGRES_USER=bot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bot

# ------------------------------------------------------------
#  DATABASE_URL  (required)
#  How the bot connects to the database. Must match the values above:
#    postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/POSTGRES_DB
#  Special characters in the password (e.g. @ / : #) must be URL-encoded.
# ------------------------------------------------------------
DATABASE_URL=postgresql://bot:change-me@localhost:5432/bot
