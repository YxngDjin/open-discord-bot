# ============================================================
#  open-discord-bot – Configuration
#  Copy this file to ".env" and fill in your values.
#  Never commit or share your .env file!
# ============================================================

# ------------------------------------------------------------
#  DISCORD_TOKEN  (required)
#  The token of your bot. Keep it secret!
#  Where to find it:
#    https://discord.com/developers/applications
#    -> your application -> "Bot" -> "Reset Token"
# ------------------------------------------------------------
DISCORD_TOKEN=

# ------------------------------------------------------------
#  LOG_LEVEL  (optional, default: log)
#  How much the bot writes to the console.
#  Allowed values, from least to most output:
#    fatal | error | warn | log | debug | verbose
#  Remove the "#" to change it.
# ------------------------------------------------------------
# LOG_LEVEL=log

# ------------------------------------------------------------
#  DEV_GUILD_ID  (optional, for development only)
#  If set, slash commands are registered ONLY on this server,
#  but they show up instantly. Useful while developing.
#  Leave it unset in production so commands work on all servers.
#
#  How to get the ID:
#    Discord -> User Settings -> Advanced -> enable "Developer Mode",
#    then right-click your server -> "Copy Server ID"
# ------------------------------------------------------------
# DEV_GUILD_ID=

# ------------------------------------------------------------
#  BOT_TAG  (optional, default: latest)
#  Which Docker image of the bot to run:
#    latest       the newest release (recommended)
#    0.2.0        a fixed version, no automatic updates
#    development  the current development state, may be unstable
#  Remove the "#" to change it, then run:
#    docker compose pull && docker compose up -d
# ------------------------------------------------------------
# BOT_TAG=latest

# ============================================================
#  Dashboard (optional)
# ============================================================

# ------------------------------------------------------------
#  DASHBOARD_ENABLED  (optional, default: false)
#  Starts the web server for the dashboard. Without it, the bot
#  runs without any web server and opens no port.
#  Allowed values: true | false
#  Remove the "#" to change it.
# ------------------------------------------------------------
# DASHBOARD_ENABLED=false

# ------------------------------------------------------------
#  PORT  (optional, default: 3000)
#  The port of the web server. Only used when DASHBOARD_ENABLED=true.
# ------------------------------------------------------------
# PORT=3000

# ------------------------------------------------------------
#  DISCORD_CLIENT_SECRET  (required when DASHBOARD_ENABLED=true)
#  Used for "Log in with Discord" in the dashboard. Keep it secret!
#  Where to find it:
#    https://discord.com/developers/applications
#    -> your application -> "OAuth2" -> "Client Secret" -> "Reset Secret"
# ------------------------------------------------------------
# DISCORD_CLIENT_SECRET=

# ------------------------------------------------------------
#  DASHBOARD_URL  (required when DASHBOARD_ENABLED=true)
#  The address you open the dashboard at, e.g.
#    http://localhost:3000        (on the same machine)
#    http://192.168.0.17:3000     (in your home network)
#    https://bot.example.com      (behind a reverse proxy with HTTPS)
#  In the Developer Portal under "OAuth2" -> "Redirects", add this
#  address followed by /api/auth/callback, e.g.
#    http://localhost:3000/api/auth/callback
# ------------------------------------------------------------
# DASHBOARD_URL=

# ============================================================
#  Database
# ============================================================

# ------------------------------------------------------------
#  POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB  (required)
#  Credentials for the PostgreSQL container in compose.yaml.
#  Choose your own secure password!
# ------------------------------------------------------------
POSTGRES_USER=bot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bot

# ------------------------------------------------------------
#  DATABASE_URL  (only needed when the bot runs WITHOUT Docker)
#  With "docker compose up", compose.yaml builds this URL itself from the
#  values above, so you can leave it as it is.
#  Without Docker (development), it must match the values above:
#    postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/POSTGRES_DB
#  Special characters in the password (e.g. @ / : #) must be URL-encoded.
# ------------------------------------------------------------
DATABASE_URL=postgresql://bot:change-me@localhost:5432/bot
